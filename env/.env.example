# Copy this file to the project root as .env and fill in real values.
# Do not commit .env (it is in .gitignore).

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=add_product
POSTGRES_USER=add_product
POSTGRES_PASSWORD=changeme

# App
APP_BASE_URL=http://localhost:8080
APP_LOCALE_DEFAULT=ru

# SMTP (verification emails)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=changeme
SMTP_FROM=noreply@localhost

# OpenAI (GPT + embeddings)
OPENAI_API_KEY=changeme
GPT_EMBEDDING_MODEL=text-embedding-3-small

# Proxy (optional; empty = no proxy)
PROXY_ADDR=
PROXY_USER=
PROXY_PASS=

# DeepSeek (chat completions)
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=changeme

# Optional: Qdrant
QDRANT_URL=http://localhost:6333
